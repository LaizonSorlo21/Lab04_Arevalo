<Window x:Class="WPF_SP.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NeptunoDB | Mantenimiento" Height="800" Width="1220" MinHeight="650" MinWidth="950" WindowStartupLocation="CenterScreen">
<Window.Resources><Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="True"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="Margin" Value="0,12,0,0"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#172033"/><Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F5F7FB"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="RowHeight" Value="32"/></Style><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#E7EAF1"/><Setter Property="Foreground" Value="#172033"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8"/></Style><Style TargetType="ComboBox"><Setter Property="MinWidth" Value="150"/><Setter Property="Margin" Value="0,3,10,8"/><Setter Property="Padding" Value="6"/></Style><Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"><Setter Property="Margin" Value="0,3,10,8"/><Setter Property="MinWidth" Value="150"/></Style><Style TargetType="DatePicker"><Setter Property="Margin" Value="0,3,10,8"/><Setter Property="MinWidth" Value="150"/></Style></Window.Resources>
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="White" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="2,0,2,14" Margin="0,0,0,16"><TextBlock Text="Sistema de Gestion Comercial" FontSize="22" FontWeight="SemiBold"/></Border>
<TabControl Grid.Row="1" Background="{StaticResource SurfaceBrush}">
<TabItem Header="Productos"><Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Registrar producto" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Complete los datos y presione Guardar" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,15"/><TextBlock Text="Nombre del producto *" FontWeight="SemiBold"/><TextBox x:Name="txtProductoNombre"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="Proveedor" FontWeight="SemiBold"/><ComboBox x:Name="cbProductoProveedor" DisplayMemberPath="Nombre" SelectedValuePath="Id" MinWidth="0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Categoría" FontWeight="SemiBold"/><ComboBox x:Name="cbProductoCategoria" DisplayMemberPath="Nombre" SelectedValuePath="Id" MinWidth="0"/></StackPanel></Grid><TextBlock Text="Cantidad por unidad" FontWeight="SemiBold"/><TextBox x:Name="txtCantidadUnidad"/><TextBlock Text="Precio unitario *" FontWeight="SemiBold"/><TextBox x:Name="txtPrecio"/><TextBlock Text="Control de inventario" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,5"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="Existencias" FontSize="12" FontWeight="SemiBold"/><TextBox x:Name="txtExistencias" MinWidth="0" Margin="0,3,0,8"/></StackPanel><StackPanel Grid.Column="1" Margin="3,0"><TextBlock Text="En pedido" FontSize="12" FontWeight="SemiBold"/><TextBox x:Name="txtEnPedido" MinWidth="0" Margin="0,3,0,8"/></StackPanel><StackPanel Grid.Column="2" Margin="6,0,0,0"><TextBlock Text="Reorden" FontSize="12" FontWeight="SemiBold"/><TextBox x:Name="txtReorden" MinWidth="0" Margin="0,3,0,8"/></StackPanel></Grid><CheckBox x:Name="chkDescontinuado" Content="Producto descontinuado" Margin="0,6,0,14"/><WrapPanel><Button Style="{StaticResource AccentButton}" Content="Nuevo" Click="ProductoNuevo_Click"/><Button Style="{StaticResource OutlineButton}" Content="Guardar cambios" Click="ProductoGuardar_Click" Margin="8,0,0,0"/><Button Style="{StaticResource OutlineButton}" Content="Eliminar" Click="ProductoEliminar_Click" Margin="8,0,0,0"/></WrapPanel></StackPanel></ScrollViewer></Border><Border Grid.Column="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Lista de productos" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Seleccione una fila para editar o eliminar" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,2"/></StackPanel><DataGrid x:Name="dgProductos" Grid.Row="1" AutoGenerateColumns="False" SelectionChanged="Productos_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="*" MinWidth="160"/><DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="130"/><DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="110"/><DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnidad, StringFormat=N2}" Width="75"/><DataGridTextColumn Header="Stock" Binding="{Binding UnidadesEnExistencia}" Width="60"/><DataGridTextColumn Header="Pedido" Binding="{Binding UnidadesEnPedido}" Width="65"/><DataGridTextColumn Header="Reorden" Binding="{Binding NivelDeReorden}" Width="70"/><DataGridCheckBoxColumn Header="Descont." Binding="{Binding Descontinuado}" Width="75"/></DataGrid.Columns></DataGrid></Grid></Border></Grid></TabItem>
<TabItem Header="Categorías"><Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Categoría" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Nombre *"/><TextBox x:Name="txtCategoriaNombre"/><TextBlock Text="Descripción"/><TextBox x:Name="txtCategoriaDescripcion" Height="90" TextWrapping="Wrap" AcceptsReturn="True"/><WrapPanel><Button Style="{StaticResource AccentButton}" Content="Nuevo" Click="CategoriaNuevo_Click"/><Button Style="{StaticResource OutlineButton}" Content="Guardar" Click="CategoriaGuardar_Click" Margin="8,0,0,0"/><Button Style="{StaticResource OutlineButton}" Content="Eliminar" Click="CategoriaEliminar_Click" Margin="8,0,0,0"/></WrapPanel></StackPanel><DataGrid x:Name="dgCategorias" Grid.Column="1" SelectionChanged="Categorias_SelectionChanged"/></Grid></TabItem>
<TabItem Header="Proveedores"><Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ScrollViewer><StackPanel><TextBlock Text="Proveedor" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Compañía *"/><TextBox x:Name="txtProveedorCompania"/><TextBlock Text="Contacto / Cargo"/><StackPanel Orientation="Horizontal"><TextBox x:Name="txtProveedorContacto"/><TextBox x:Name="txtProveedorCargo"/></StackPanel><TextBlock Text="Dirección / Ciudad"/><StackPanel Orientation="Horizontal"><TextBox x:Name="txtProveedorDireccion"/><TextBox x:Name="txtProveedorCiudad"/></StackPanel><TextBlock Text="Código postal / País"/><StackPanel Orientation="Horizontal"><TextBox x:Name="txtProveedorPostal"/><TextBox x:Name="txtProveedorPais"/></StackPanel><TextBlock Text="Teléfono / Fax"/><StackPanel Orientation="Horizontal"><TextBox x:Name="txtProveedorTelefono"/><TextBox x:Name="txtProveedorFax"/></StackPanel><WrapPanel><Button Style="{StaticResource AccentButton}" Content="Nuevo" Click="ProveedorNuevo_Click"/><Button Style="{StaticResource OutlineButton}" Content="Guardar" Click="ProveedorGuardar_Click" Margin="8,0,0,0"/><Button Style="{StaticResource OutlineButton}" Content="Eliminar" Click="ProveedorEliminar_Click" Margin="8,0,0,0"/></WrapPanel></StackPanel></ScrollViewer><DataGrid x:Name="dgProveedores" Grid.Column="1" SelectionChanged="Proveedores_SelectionChanged"/></Grid></TabItem>
<TabItem Header="Buscar proveedores"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><StackPanel><TextBlock Text="Nombre de contacto"/><TextBox x:Name="txtBuscarContacto"/></StackPanel><StackPanel><TextBlock Text="Ciudad"/><TextBox x:Name="txtBuscarCiudad"/></StackPanel><Button Style="{StaticResource AccentButton}" Content="Buscar" Click="BuscarProveedores_Click" Margin="0,23,8,0"/><Button Style="{StaticResource OutlineButton}" Content="Limpiar" Click="LimpiarBusquedaProveedores_Click" Margin="0,23,0,0"/></WrapPanel><DataGrid x:Name="dgBusquedaProveedores" Grid.Row="1"/></Grid></TabItem>
<TabItem Header="Pedidos"><Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ScrollViewer><StackPanel><TextBlock Text="Pedido" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Cliente"/><ComboBox x:Name="cbPedidoCliente" DisplayMemberPath="Nombre" SelectedValuePath="Id"/><TextBlock Text="Empleado"/><ComboBox x:Name="cbPedidoEmpleado" DisplayMemberPath="Nombre" SelectedValuePath="Id"/><TextBlock Text="Fecha de pedido *"/><DatePicker x:Name="dpFechaPedido"/><TextBlock Text="Fecha requerida / envío"/><StackPanel Orientation="Horizontal"><DatePicker x:Name="dpFechaRequerida"/><DatePicker x:Name="dpFechaEnvio"/></StackPanel><TextBlock Text="Transportista"/><ComboBox x:Name="cbPedidoTransportista" DisplayMemberPath="Nombre" SelectedValuePath="Id"/><TextBlock Text="Destinatario / Ciudad / País"/><TextBox x:Name="txtDestinatario"/><StackPanel Orientation="Horizontal"><TextBox x:Name="txtCiudadDestino"/><TextBox x:Name="txtPaisDestino"/></StackPanel><WrapPanel><Button Style="{StaticResource AccentButton}" Content="Nuevo" Click="PedidoNuevo_Click"/><Button Style="{StaticResource OutlineButton}" Content="Guardar" Click="PedidoGuardar_Click" Margin="8,0,0,0"/><Button Style="{StaticResource OutlineButton}" Content="Eliminar" Click="PedidoEliminar_Click" Margin="8,0,0,0"/></WrapPanel></StackPanel></ScrollViewer><DataGrid x:Name="dgPedidos" Grid.Column="1" SelectionChanged="Pedidos_SelectionChanged"/></Grid></TabItem>
<TabItem Header="Reporte de detalles"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><StackPanel><TextBlock Text="Desde"/><DatePicker x:Name="dpDesde"/></StackPanel><StackPanel><TextBlock Text="Hasta"/><DatePicker x:Name="dpHasta"/></StackPanel><Button Style="{StaticResource AccentButton}" Content="Generar reporte" Click="Reporte_Click" Margin="0,23,0,0"/></WrapPanel><DataGrid x:Name="dgReporte" Grid.Row="1"/></Grid></TabItem>
</TabControl><TextBlock x:Name="lblEstado" Grid.Row="2" Margin="4,12,0,0" Foreground="{StaticResource TextSecondaryBrush}"/></Grid></Window>
