<Application x:Class="WPF_SP.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WPF_SP"
             xmlns:conv="clr-namespace:WPF_SP.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:EnumEqualsConverter x:Key="EnumEquals"/>
            <conv:BoolToStrikethroughConverter x:Key="BoolToStrikethrough"/>
            <conv:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibility"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
