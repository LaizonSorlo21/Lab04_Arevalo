<Window x:Class="WPF_SP.Views.TareaEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding TituloVentana}" Height="350" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">
    
    <Border Background="{StaticResource SurfaceBrush}" 
            CornerRadius="18" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1"
            Padding="24">
        
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.15" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabecera / Título de la ventana -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource AccentLightBrush}" Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0">
                    <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding TituloVentana}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Campo Título -->
            <TextBlock Grid.Row="1" Text="Título de la tarea" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,20,0,6" FontSize="12"/>
            <TextBox Grid.Row="2" Style="{StaticResource ModernTextBox}" 
                     Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     MaxLength="150" x:Name="TituloBox"/>

            <!-- Campo Descripción -->
            <TextBlock Grid.Row="3" Text="Descripción (opcional)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,6" FontSize="12"/>
            <TextBox Grid.Row="4" Style="{StaticResource ModernTextBox}" 
                     Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="75" VerticalContentAlignment="Top"/>

            <!-- Botones de Acción (Viculados directamente al ViewModel MVVM) -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Cancelar" 
                        Style="{StaticResource OutlineButton}" 
                        Width="100" 
                        Margin="0,0,10,0"
                        Command="{Binding CancelarCommand}"/>
                
                <Button Content="Guardar" 
                        Style="{StaticResource AccentButton}" 
                        Width="110"
                        IsDefault="True"
                        Command="{Binding GuardarCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>